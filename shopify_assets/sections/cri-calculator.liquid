{% comment %}
  CRi Energy - Custom ROI Calculator Section for Shopify (Online Store 2.0)
  Save this file as sections/cri-calculator.liquid in your Shopify Theme editor.
{% endcomment %}

<div class="cri-shopify-calculator" style="background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0; color: #0f172a; font-family: 'Outfit', 'Noto Sans TC', sans-serif;">
  <div class="shopify-container" style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    
    <div class="section-header" style="text-align: center; margin-bottom: 48px;">
      <h2 style="font-size: 2.2rem; font-weight: 800; color: #1b4332; margin-bottom: 12px;">
        {{ section.settings.title }}
      </h2>
      <p style="color: #64748b; font-size: 1.05rem; max-width: 600px; margin: 0 auto;">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <div class="calculator-wrapper" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; background: #ffffff; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e2e8f0;">
      <!-- Inputs Column -->
      <div class="calc-panel" style="padding: 40px; background: #ffffff;">
        <h3 style="font-size: 1.35rem; font-weight: 800; color: #1b4332; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
          <span style="color:#0077b6;">■</span> 1. {{ section.settings.input_header }}
        </h3>
        
        <div class="form-group" style="margin-bottom: 24px;">
          <label style="display: block; font-weight: 700; margin-bottom: 8px; font-size: 0.95rem;">
            {{ section.settings.label_type }}
          </label>
          <select id="sfCalcRoofType" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 4px; font-family: inherit; font-size: 0.95rem;">
            <option value="factory">老舊廠房浪板屋頂 (平面貼合)</option>
            <option value="greenhouse">設施農業大棚玻璃 (曲面貼合)</option>
            <option value="bipv">都市帷幕大樓立面 (BIPV立面)</option>
            <option value="repower">舊光電電站就地改裝 (2.0倍增益)</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
          <label style="display: block; font-weight: 700; margin-bottom: 8px; font-size: 0.95rem;">
            {{ section.settings.label_area }}
          </label>
          <div style="display: flex; gap: 12px; align-items: center;">
            <input type="number" id="sfRoofArea" value="500" min="10" max="10000" style="flex: 1; padding: 12px; border: 1px solid #cbd5e1; border-radius: 4px; font-family: inherit; font-size: 0.95rem;">
            <span style="font-weight: 700; color: #0f172a;">坪</span>
          </div>
          <input type="range" id="sfRoofAreaSlider" min="10" max="10000" value="500" style="width: 100%; margin-top: 16px; accent-color: #0077b6;">
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 700; font-size: 0.95rem;">
            <input type="checkbox" id="sfAddStorage" checked style="width: 18px; height: 18px; accent-color: #0077b6;">
            <span>{{ section.settings.label_ess }}</span>
          </label>
          <p style="font-size: 0.85rem; color: #64748b; margin-top: 8px; margin-left: 26px; line-height: 1.4;">
            {{ section.settings.ess_desc }}
          </p>
        </div>
      </div>

      <!-- Results Column -->
      <div class="calc-result-panel" style="padding: 40px; background: #0f172a; color: #ffffff; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <h3 style="font-size: 1.35rem; font-weight: 800; color: #ffffff; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
            <span style="color:#0077b6;">■</span> 2. {{ section.settings.result_header }}
          </h3>
          
          <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
            <div style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
              <span style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 4px;">預估光電 / 儲能量</span>
              <div style="font-size: 1.5rem; font-weight: 800;">
                <span id="sfResCapacity">--</span> <span style="font-size: 0.9rem; color: #94a3b8;">kWp</span>
                <span id="sfEssDivider" style="display:none;"> / </span>
                <span id="sfResStorageCapacity" style="display:none; color: #0096c7;">--</span>
                <span id="sfEssUnitText" style="display:none;" style="font-size: 0.9rem; color: #94a3b8;"> kWh</span>
              </div>
            </div>

            <div style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
              <span style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 4px;">預估年發電量</span>
              <div style="font-size: 1.5rem; font-weight: 800;"><span id="sfResGeneration">--</span> <span style="font-size: 0.9rem; color: #94a3b8;">kWh / 度</span></div>
            </div>

            <div style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
              <span style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 4px;">年排碳扣抵量</span>
              <div style="font-size: 1.5rem; font-weight: 800;"><span id="sfResCarbon">--</span> <span style="font-size: 0.9rem; color: #94a3b8;">Kg-CO2</span></div>
            </div>

            <div style="background: rgba(0, 119, 182, 0.1); border: 1px solid rgba(0, 119, 182, 0.3); padding: 16px; border-radius: 4px;">
              <span style="display: block; font-size: 0.85rem; color: #0096c7; margin-bottom: 4px; font-weight: 700;">光自用 + 儲能套利總年省</span>
              <div style="font-size: 1.8rem; font-weight: 800; color: #0096c7;" id="sfResSavings">--</div>
            </div>
          </div>
        </div>

        <div style="margin-top: 24px;">
          <a href="{{ section.settings.button_link }}" style="display: block; width: 100%; text-align: center; background: #0077b6; color: #ffffff; padding: 14px; text-decoration: none; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem; transition: background 0.3s;">
            {{ section.settings.button_text }}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const areaInput = document.getElementById('sfRoofArea');
    const areaSlider = document.getElementById('sfRoofAreaSlider');
    const typeSelect = document.getElementById('sfCalcRoofType');
    const storageCheck = document.getElementById('sfAddStorage');

    const resCapacity = document.getElementById('sfResCapacity');
    const resStorageCapacity = document.getElementById('sfResStorageCapacity');
    const essDivider = document.getElementById('sfEssDivider');
    const essUnitText = document.getElementById('sfEssUnitText');
    const resGeneration = document.getElementById('sfResGeneration');
    const resCarbon = document.getElementById('sfResCarbon');
    const resSavings = document.getElementById('sfResSavings');

    function calculatesfROI() {
      if (!areaInput) return;
      const area = parseFloat(areaInput.value) || 0;
      const type = typeSelect.value;
      const addStorage = storageCheck.checked;

      let baseCapacityFactor = 6.0;
      let solarEfficiencyFactor = 0.90;

      if (type === 'factory') {
        baseCapacityFactor = 6.0;
        solarEfficiencyFactor = 0.90;
      } else if (type === 'greenhouse') {
        baseCapacityFactor = 6.0;
        solarEfficiencyFactor = 0.85;
      } else if (type === 'bipv') {
        baseCapacityFactor = 8.0;
        solarEfficiencyFactor = 0.70;
      } else if (type === 'repower') {
        baseCapacityFactor = 6.0;
        solarEfficiencyFactor = 1.80;
      }

      const capacity = area / baseCapacityFactor;
      const storageCapacity = addStorage ? capacity * 2.0 : 0;
      const annualGeneration = capacity * 1200 * solarEfficiencyFactor;
      const carbonReduction = annualGeneration * 0.495;

      const solarAnnualSavings = annualGeneration * 4.0;
      const storageAnnualSavings = storageCapacity * 3.5 * 300;
      const totalAnnualSavings = solarAnnualSavings + storageAnnualSavings;

      resCapacity.innerText = capacity.toFixed(1);
      resGeneration.innerText = Math.round(annualGeneration).toLocaleString();
      resCarbon.innerText = Math.round(carbonReduction).toLocaleString();

      if (addStorage) {
        resStorageCapacity.style.display = 'inline';
        essDivider.style.display = 'inline';
        essUnitText.style.display = 'inline';
        resStorageCapacity.innerText = Math.round(storageCapacity).toLocaleString();
      } else {
        resStorageCapacity.style.display = 'none';
        essDivider.style.display = 'none';
        essUnitText.style.display = 'none';
      }

      resSavings.innerText = `NT$ ${Math.round(totalAnnualSavings).toLocaleString()} 元`;
    }

    if (areaInput && areaSlider) {
      areaInput.addEventListener('input', (e) => {
        let val = parseFloat(e.target.value) || 0;
        if (val < 10) val = 10;
        if (val > 10000) val = 10000;
        areaSlider.value = val;
        calculatesfROI();
      });

      areaSlider.addEventListener('input', (e) => {
        areaInput.value = e.target.value;
        calculatesfROI();
      });

      typeSelect.addEventListener('change', calculatesfROI);
      storageCheck.addEventListener('change', calculatesfROI);
      calculatesfROI();
    }
  });
</script>

{% schema %}
{
  "name": "CRi ROI Calculator",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "區塊標題",
      "default": "光儲聯合 ROI 效益估算"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副標題",
      "default": "輸入可用屋頂面積，即時模擬發電容量與配儲年套利回報。"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景顏色",
      "default": "#f8f9fa"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "上下外距 (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "text",
      "id": "input_header",
      "label": "輸入側小標",
      "default": "輸入場域參數"
    },
    {
      "type": "text",
      "id": "label_type",
      "label": "下拉選單標籤",
      "default": "場景類型 (對應不同發電增益)"
    },
    {
      "type": "text",
      "id": "label_area",
      "label": "面積欄位標籤",
      "default": "可用面積大小 (坪)"
    },
    {
      "type": "text",
      "id": "label_ess",
      "label": "配建儲能勾選框",
      "default": "同步配建 CRi-ESS 智能儲能櫃 (建議)"
    },
    {
      "type": "text",
      "id": "ess_desc",
      "label": "儲能描述文字",
      "default": "系統將自動匹配「太陽能建置容量 x 2.0倍 (kWh)」的儲能配置，進行每日峰谷電價避峰套利。"
    },
    {
      "type": "text",
      "id": "result_header",
      "label": "輸出側小標",
      "default": "估算結果"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按鈕文字",
      "default": "索取正式光儲評估報價單"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按鈕連結",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "CRi ROI Calculator",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
